generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator         Boolean?  @default(false)
  emailVerified        Boolean?  @default(false)
  refreshToken         String?
  refreshTokenExpires  DateTime?
}

// Per-shop, per-month edited-image counter used to enforce plan quotas.
// `period` is "YYYY-MM"; a new row is created each month so usage resets.
model UsageCounter {
  id         String @id @default(cuid())
  shop       String
  period     String // "2026-06"
  imagesUsed Int    @default(0)

  @@unique([shop, period])
}

// Per-shop branding settings used by the studio's watermark/badge/canvas ops.
// The logo is stored inline as a data URI; uploads are capped small (≤500 KB)
// so a TEXT column is fine and no file storage is needed.
model ShopSettings {
  shop              String  @id
  watermarkMode     String  @default("text") // "text" | "logo"
  watermarkText     String  @default("")
  watermarkLogo     String? // data: URI (png/jpeg/webp), small
  watermarkPosition String  @default("southeast") // 9-grid gravity
  watermarkOpacity  Int     @default(55) // percent
  watermarkScale    Int     @default(22) // percent of image width
  badgeText         String  @default("SALE")
  badgeColor        String  @default("#D7263D")
  badgePosition     String  @default("northwest")
  canvasRatio       String  @default("1:1") // "1:1" | "4:5" | "3:4" | "16:9"
  canvasColor       String  @default("#FFFFFF")
}

// One row per image edit the studio performed — the source for the History
// page and the per-product "edits" counts on the studio catalog. `ops` is a
// JSON array of operation names (e.g. ["canvas","watermark"]).
model StudioEdit {
  id           String   @id @default(cuid())
  shop         String
  productId    String
  productTitle String   @default("")
  imageId      String
  newImageId   String
  ops          String
  createdAt    DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, productId])
}
