# Pixoraft — environment template.
# Copy to .env for local development; on Coolify these are set as resource
# environment variables. Never commit the real .env.

# ── Shopify app credentials (Partner Dashboard → App setup) ───────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public HTTPS origin of this deployment. Must match application_url and the
# redirect_urls in shopify.app.toml exactly.
SHOPIFY_APP_URL=https://pixoraft.onkra.online
SCOPES=write_products,write_files
# The app's handle, used to build the Shopify-hosted managed-pricing URL.
SHOPIFY_APP_HANDLE=pixoraft

# ── Database ──────────────────────────────────────────────────────────────
# Postgres. `npm run setup` (prisma db push) creates the schema on boot.
DATABASE_URL=postgres://user:password@host:5432/pixoraft

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Billing display (optional) ────────────────────────────────────────────
# Managed Pricing: the real amounts live in the Partner Dashboard. These only
# control what the app displays and the fallback billing config.
# BILLING_PLAN_NAME=Basic
# BILLING_CURRENCY=USD
# BILLING_TRIAL_DAYS=0
# BILLING_AMOUNT=60
# BILLING_AMOUNT_YEARLY=600
# BILLING_YEARLY_ENABLED=true

# ── Studio tuning (optional) ──────────────────────────────────────────────
# STUDIO_JPEG_QUALITY=92
# SHARP_CONCURRENCY=2

# ── Development only — NEVER set in production ────────────────────────────
# Development stores cannot approve paid managed-pricing subscriptions, so this
# forces a plan tier for testing.
# DEV_PLAN_OVERRIDE=pro
# DEV_PLAN_OVERRIDE_SHOP=my-dev-store.myshopify.com
